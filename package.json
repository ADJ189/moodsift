{
  "name": "moodsift",
  "version": "1.13.5",
  "private": true,
  "type": "module",
  "description": "Moodsift \u2014 a fast, framework-free movie & TV recommendation engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lhci": "npx --yes @lhci/cli autorun",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:visual": "VISUAL=1 playwright test --project=chromium-desktop visual.spec.ts",
    "test:install": "playwright install --with-deps chromium",
    "ai:manifest": "node scripts/generate-ai-manifest.mjs",
    "ai:manifest:check": "node scripts/generate-ai-manifest.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "undici": "7.30.1",
    "sharp": "0.35.5"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "lz-string": "1.5.0"
  }
}
