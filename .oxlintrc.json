{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist/**", "node_modules/**", ".wrangler/**", "tests/vendor/**"],
  "rules": {
    "no-unused-vars": "off",
    "no-underscore-dangle": "off",
    "unicorn/no-array-sort": "off",
    "no-unused-expressions": "off"
  }
}
