{
  // The Worker name is also the workers.dev subdomain
  // (https://moodsift.adj189.workers.dev). `wrangler deploy` matches on
  // name, so a Worker with this name needs VITE_TMDB_TOKEN (and optionally
  // VITE_OMDB_KEY) set as build variables of its own — renaming creates a
  // new, unconfigured Worker rather than updating the old one.
  "name": "moodsift",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // OFF by default (v1.13.5). The frontend never calls POST /api/recommend —
  // ranking is client-side and on-device AI runs in the browser — so leaving
  // the Workers AI binding on only exposed an unauthenticated, quota-spending
  // route. worker/index.ts answers 503 whenever env.AI is absent.
  //
  // To re-enable the optional server-side re-ranking pass, turn on BOTH of
  // these (and the AI binding in the Cloudflare dashboard: Settings ->
  // Bindings -> AI). The route refuses to run without the shared limiter:
  //
  // "ai": { "binding": "AI" },
  // "ratelimits": [
  //   { "name": "RECOMMEND_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  // ],
  //
  // Also set a spend/usage alert for Workers AI in the Cloudflare dashboard.
  "observability": {
    "enabled": true
  }
}
